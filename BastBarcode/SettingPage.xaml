<Page
    x:Class="BastBarcode.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BastBarcode"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="0,0.5,0,0">
        <Border Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="0,5,0,0" CornerRadius="5" Padding="10">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock FontWeight="Bold" HorizontalAlignment="Center" FontSize="20" Text="Settings" Margin="0,0,0,20"/>
                <muxc:RadioButtons>
                    <RadioButton x:Name="RadioBtn_OneBtn" Content="Single button for print and save (Data will save after printing)" Checked="RadioButton_OneBtn_Checked"/>
                    <RadioButton x:Name="RadioBtn_TwoBtn" Content="Different buttons for save and print (Save button must be pressed to save data)" Checked="RadioButton_TwoBtn_Checked"/>
                </muxc:RadioButtons>
                <Border HorizontalAlignment="Stretch" Height="1" BorderBrush="{ThemeResource SystemAccentColorDark3}" BorderThickness="0,0.5,0,0" Margin="0,10"/>
                <CheckBox x:Name="ChkBx_ConfrmBtn" Click="ChkBx_ConfrmBtn_Click" IsChecked="True" Content="Show confirm button"/>
                <Border HorizontalAlignment="Stretch" Height="1" BorderBrush="{ThemeResource SystemAccentColorDark3}" BorderThickness="0,0.5,0,0" Margin="0,10"/>
                <muxc:RadioButtons>
                    <RadioButton x:Name="RadioBtn_light" Content="Light Theme"/>
                    <RadioButton x:Name="RadioBtn_dark" Content="Dark Theme"/>
                    <RadioButton x:Name="RadioBtn_system" Content="System Theme"/>
                </muxc:RadioButtons>
            </StackPanel>
        </Border>
        <Button Grid.Row="2" Margin="10" Padding="5" Click="Btn_AboutUs" VerticalAlignment="Bottom" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Made By"/>
                <TextBlock Margin="3,0,0,0" FontWeight="Bold" Text="Abu Bakar"/>
            </StackPanel>
        </Button>
    </Grid>
</Page>
